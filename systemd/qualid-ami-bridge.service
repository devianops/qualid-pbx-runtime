[Unit]
Description=Quali-D AMI Bridge — streams Asterisk call events to relay
After=network.target asterisk.service
Requires=asterisk.service

[Service]
ExecStart=/usr/bin/python3 /opt/qualid/ami_bridge/ami_bridge.py
Restart=always
RestartSec=5
User=asterisk
StandardOutput=journal
StandardError=journal
SyslogIdentifier=qualid-ami-bridge

[Install]
WantedBy=multi-user.target
